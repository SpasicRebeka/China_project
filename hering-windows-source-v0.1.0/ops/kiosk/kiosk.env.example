# Copy this file to kiosk.env and adjust it after running `xrandr --listmonitors`.
HERING_BASE_URL=http://127.0.0.1:8000
HERING_PORT=8000

# Xorg monitor/output names and logical window rectangles.
DOCTOR_OUTPUT=HDMI-1
PATIENT_OUTPUT=HDMI-2
DOCTOR_WINDOW_POSITION=0,0
PATIENT_WINDOW_POSITION=1024,0
DOCTOR_WINDOW_SIZE=1024,600
PATIENT_WINDOW_SIZE=1024,600

# Optional exact `xinput list --name-only` device names.
DOCTOR_TOUCH_DEVICE=
PATIENT_TOUCH_DEVICE=

# Override only when Chromium is not discoverable automatically.
CHROMIUM_BIN=
